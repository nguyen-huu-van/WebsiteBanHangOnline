@using WebsiteBanHangOnline.Models
@model SanPham
@{
    ViewBag.Title = "ChiTietSanPham";
    Layout = "~/Views/Layout/_LayoutHomeProduct.cshtml";
}


        <section class="breadcrumb-section">
            <h2 class="sr-only">Site Breadcrumb</h2>
            <div class="container">
                <div class="breadcrumb-contents">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("DanhSachSanPham","Home")">Trang Chủ</a></li>
                            <li class="breadcrumb-item active">Trang Chi Tiết</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </section>
        
        <main class="inner-page-sec-padding-bottom">
            <div class="container">
                <div class="row  mb--60">
                    <div class="col-lg-5 mb--30">
                        <!-- Product Details Slider Big Image-->
                        <div class="product-details-slider sb-slick-slider arrow-type-two" data-slick-setting='{
              "slidesToShow": 1,
              "arrows": false,
              "fade": true,
              "draggable": false,
              "swipe": false,
              "asNavFor": ".product-slider-nav"
              }'>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh1" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh2" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh3" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                            </div>
                        </div>
                        <!-- Product Details Slider Nav -->
                        <div class="mt--30 product-slider-nav sb-slick-slider arrow-type-two" data-slick-setting='{
            "infinite":true,
              "autoplay": true,
              "autoplaySpeed": 8000,
              "slidesToShow": 4,
              "arrows": true,
              "prevArrow":{"buttonClass": "slick-prev","iconClass":"fa fa-chevron-left"},
              "nextArrow":{"buttonClass": "slick-next","iconClass":"fa fa-chevron-right"},
              "asNavFor": ".product-details-slider",
              "focusOnSelect": true
              }'>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh1" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh2" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh3" alt="">
                            </div>
                            <div class="single-slide">
                                <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="product-details-info pl-lg--30 ">
                            <h3 class="product-title">@Model.TenSP</h3>
                            <div class="price-block">
                                <span class="price-new">@Model.DonGia.Value.ToString("#,## ₫") </span>
                                @*<span class="price-new">@Model.DonGia.ToString("#,##0") + " ₫"</span>*@
                            </div>
                            <article class="product-details-article">
                                <h4 class="sr-only">Mô tả</h4>
                                <p>
                                   @Model.MoTa
                                </p>
                            </article>
                            <div class="add-to-cart-row">
                                <div class="count-input-block">
                                    <span class="widget-label">Số lượng</span>
                                    <input class="form-control text-center" value="1" type="text">
                                </div>
                                <div class="add-cart-btn">
                                    @if (Session["TaiKhoan"] != null)
                                    {
                                        <a class="btn btn-outlined--primary" href="@Url.Action("ThemGioHang", "GioHang", new { @maSP = Model.MaSP, @strULR = Request.Url.ToString() })" title="Thêm vào giỏ hàng">Thêm vào giỏ hàng</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-outlined--primary" href="@Url.Action("DangNhap","Home")">Thêm vào giỏ hàng</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--=================================
        RELATED PRODUCTS BOOKS
    ===================================== -->
            @Html.Action("SanPhamLienQuan", new { maLoai = Model.MaLoaiSP, maSP = Model.MaSP })
            <!-- Modal -->
            <div class="modal fade modal-quick-view" id="quickModal" tabindex="-1" role="dialog"
                 aria-labelledby="quickModal" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        <div class="product-details-modal">
                            <div class="row">
                                <div class="col-lg-5">
                                    <!-- Product Details Slider Big Image-->
                                    <div class="product-details-slider sb-slick-slider arrow-type-two" data-slick-setting='{
                                "slidesToShow": 1,
                                "arrows": false,
                                "fade": true,
                                "draggable": false,
                                "swipe": false,
                                "asNavFor": ".product-slider-nav"
                                }'>
                                        <div class="single-slide">
                                            <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                                        </div>
                                        <div class="single-slide">
                                            <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh1" alt="">
                                        </div>
                                        <div class="single-slide">
                                            <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh2" alt="">
                                        </div>
                                        <div class="single-slide">
                                            <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh3" alt="">
                                        </div>
                                        <div class="single-slide">
                                            <img src="~/Content/assets/image/HinhAnh/@Model.HinhAnh" alt="">
                                        </div>
                                    </div>
                                    <!-- Product Details Slider Nav -->
                                    <div class="mt--30 product-slider-nav sb-slick-slider arrow-type-two"
                                         data-slick-setting='{
        "infinite":true,
          "autoplay": true,
          "autoplaySpeed": 8000,
          "slidesToShow": 4,
          "arrows": true,
          "prevArrow":{"buttonClass": "slick-prev","iconClass":"fa fa-chevron-left"},
          "nextArrow":{"buttonClass": "slick-next","iconClass":"fa fa-chevron-right"},
          "asNavFor": ".product-details-slider",
          "focusOnSelect": true
          }'>                              
                                    </div>
                                </div>
                                
                            </div>
                        </div>  
                    </div>
                </div>
            </div>
        </main>
 
