@using WebsiteBanHangOnline.Models
@using PagedList.Mvc
@model PagedList.IPagedList<SanPham>
@{
    ViewBag.Title = "ToanBoSanPham";
    Layout = "~/Views/Layout/_LayoutHomeProduct.cshtml";
}

<main class="inner-page-sec-padding-bottom">
    <div class="container">
        <div class="shop-toolbar mb--30">
            <div class="row align-items-center">
                <div class="col-lg-2 col-md-2 col-sm-6">
                    <!-- Product View Mode -->
                    <div class="product-view-mode">
                        <a href="#" class="sorting-btn active" data-target="grid"><i class="fas fa-th"></i></a>
                        <a href="#" class="sorting-btn" data-target="grid-four">
                            <span class="grid-four-icon">
                                <i class="fas fa-grip-vertical"></i><i class="fas fa-grip-vertical"></i>
                            </span>
                        </a>
                        <a href="#" class="sorting-btn" data-target="list "><i class="fas fa-list"></i></a>
                    </div>
                </div>
                <div class="col-xl-10 col-md-4 col-sm-6  mt--10 mt-sm--0">
                    <span class="toolbar-status">
                        @Model.Count Sản Phẩm
                    </span>
                </div>

              
            </div>
        </div>
        <div class="shop-product-wrap grid with-pagination row space-db--30 shop-border">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-sm-6">
                    <div class="product-card">
                        <div class="product-grid-content">
                            <div class="product-header">
                                <h3><a href="@Url.Action("ChiTietSanPham", "Sanpham",new {maLoai = item.MaLoaiSP, maphong = item.MaPhong, id = item.MaSP ,@tensp = item.TenSP})">@item.TenSP</a></h3>
                            </div>
                            <div class="product-card--body">
                                <div class="card-image">
                                    <img src="~/Content/assets/image/HinhAnh/@item.HinhAnh" alt="" style="width: 300px; height: 300px;">
                                    <div class="hover-contents">
                                        <a href="@Url.Action("ChiTietSanPham", "Sanpham",new {maLoai = item.MaLoaiSP, maphong = item.MaPhong, id = item.MaSP ,@tensp = item.TenSP})" class="hover-image">
                                            <img src="~/Content/assets/image/HinhAnh/@item.HinhAnh" alt="" style="width: 300px; height: 300px;">
                                        </a>
                                    </div>
                                </div>
                                <div class="price-block">
                                    <span class="price">@item.DonGia.Value.ToString("#,## ₫")</span>
                                </div>
                            </div>
                        </div>
                        <div class="product-list-content">
                            <div class="card-image">
                                <a href="@Url.Action("ChiTietSanPham", "Sanpham",new {maLoai = item.MaLoaiSP, maphong = item.MaPhong, id = item.MaSP ,@tensp = item.TenSP})" class="hover-image">
                                    <img src="~/Content/assets/image/HinhAnh/@item.HinhAnh" alt="">
                                </a>
                            </div>
                            <div class="product-card--body">
                                <div class="product-header">            
                                    <h3>
                                        <a href="@Url.Action("ChiTietSanPham", "Sanpham",new {maLoai = item.MaLoaiSP, maphong = item.MaPhong, id = item.MaSP ,@tensp = item.TenSP})" tabindex="0">
                                           @item.TenSP
                                        </a>
                                    </h3>
                                </div>
                                <article>
                                    <p>
                                       @item.MoTa
                                    </p>
                                </article>
                                <div class="price-block">
                                    <span class="price">@item.DonGia</span>
                                </div>
                                <div class="rating-block">
                                    <span class="fas fa-star star_on"></span>
                                    <span class="fas fa-star star_on"></span>
                                    <span class="fas fa-star star_on"></span>
                                    <span class="fas fa-star star_on"></span>
                                    <span class="fas fa-star "></span>
                                </div>
                          
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
        <!-- Pagination Block -->
        <div class="paginatoin-area" style="margin-top:0">
            <div class="row">
                <div class="col-lg-8 col-md-6">
                    <p></p>
                </div>
                <div class="col-lg-4 col-md-6" style="box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);">
                    <ul class="pagination-box pt-xs-20 pb-xs-15">
                        <li>
                            @(Model.PageCount<Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
                        </li>
                        <li style="float:right">@Html.PagedListPager(Model, Page => @Url.Action("ToanBoSanPham", new { Page = Page }))</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</main>

