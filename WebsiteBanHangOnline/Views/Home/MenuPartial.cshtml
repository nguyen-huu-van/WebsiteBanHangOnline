@using WebsiteBanHangOnline.Models
@model IEnumerable<SanPham>

<div class="header-middle pt--10 pb--10">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-2 ">
                <a href="index.html" class="site-brand">
                    <img src="~/Content/assets/image/logo.png" alt="">
                </a>
            </div>
            <div class="col-lg-2">
                <div class="header-phone ">
                    <div class="icon">
                        <i class="fas fa-headphones-alt"></i>
                    </div>
                    <div class="text">
                        <p>Hổ trợ 24/7</p>
                        <p class="font-weight-bold number">+034-2646-293</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="main-navigation flex-lg-right">
                    <ul class="main-menu menu-right ">
                        <li class="menu-item has-children">
                            <a href="@Url.Action("DanhSachSanPham","Home")">
                                TRANG CHỦ @*<i class="fas fa-chevron-down dropdown-arrow"></i>*@
                            </a>
                        </li>
                        <li class="menu-item has-children mega-menu">
                            <a href="@Url.Action("ToanBoSanPham","Home")">
                                SẢN PHẨM
                            </a>
                        </li>
                        <li class="menu-item has-children mega-menu">
                            <a href="@Url.Action("GioiThieu","Home")">
                                TIN TỨC
                            </a>
                        </li>
                        <li class="menu-item">
                            <a href="@Url.Action("LienHe","Home")">LIÊN HỆ</a>
                        </li>
                        <div class="main-navigation flex-lg-right">
                            <ul class="main-menu menu-right ">
                                @if (Session["TaiKhoan"] != null)
                                {
                                    ThanhVien thanhVien = (ThanhVien)Session["TaiKhoan"];
                                    <li class="menu-item has-children">
                                        <a href="javascript:void(0)">
                                            <i class="fas fa-chevron-down dropdown-arrow">Xin chào: @thanhVien.HoTen </i>
                                        </a>
                                        <ul class="sub-menu">
                                            <li> <a href="~/Home/TaiKhoanCuaToi">Tài Khoản của tôi</a></li>
                                            <li>@Html.ActionLink("Đăng xuất", "DangXuat", "Home")</li>
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
